---
import Base from '../layouts/Base.astro';
import DemoStaticFragment from '../components/state-news/DemoStaticFragment.astro';
import { getConfig } from '../lib/data';
const config=(await getConfig()).data?.config ?? null;
const title=`404 | ${config?.seo?.title||'State News Digest'}`;
const description=config?.notFound?.description||'The requested page could not be found.';
---
<Base title={title} description={description} noindex={true}>
  <main><DemoStaticFragment template="404" config={config}/></main>
</Base>
