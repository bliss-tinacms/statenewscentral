---
import Base from '../../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import DemoAuthorArchive from '../../components/demo/DemoAuthorArchive.astro';
import Demo404 from '../../components/demo/Demo404.astro';
import { islands } from '../../lib/islands';
import { getConfig, getUser, listBlogs, listCategories } from '../../lib/data';

const POSTS_PER_PAGE = 6;

type ReferenceObject = {
	title?: string | null;
	name?: string | null;
	_sys?: { filename?: string | null } | null;
};

function slugify(value?: string | null) {
	return (value || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

function labelFromReference(reference: unknown) {
	if (!reference) return null;
	if (typeof reference === 'string') return reference.split('/').pop()?.replace(/\.(json|mdx?)$/, '').replace(/-/g, ' ') ?? null;
	if (typeof reference === 'object') {
		const item = reference as ReferenceObject;
		return String(item.title ?? item.name ?? '') || null;
	}
	return null;
}

function slugFromReference(reference: unknown) {
	if (!reference) return null;
	if (typeof reference === 'string') return slugify(reference.split('/').pop()?.replace(/\.(json|mdx?)$/, '') || '');
	if (typeof reference === 'object') {
		const item = reference as ReferenceObject;
		return slugify(item._sys?.filename || item.title || item.name || '');
	}
	return null;
}

function parseArchiveParam(value?: string) {
	const parts = (value || '').toLowerCase().split('/').filter(Boolean);
	const pageIndex = parts.indexOf('page');
	if (pageIndex >= 0) {
		const pageValue = parts[pageIndex + 1] || '';
		const valid = pageIndex === parts.length - 2 && /^\d+$/.test(pageValue) && Number(pageValue) >= 1;
		return { slug: parts.slice(0, pageIndex).join('/'), page: valid ? Number(pageValue) : Number.NaN, valid };
	}
	return { slug: parts.join('/'), page: 1, valid: true };
}

const parsed = parseArchiveParam(Astro.params.slug);
const config = (await getConfig()).data?.config ?? null;
const allPublishedPosts = await listBlogs();
const allPosts = allPublishedPosts.filter((post) => slugFromReference(post.author) === parsed.slug);
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const editableAuthor = parsed.slug ? (await getUser(parsed.slug)).data?.user ?? null : null;
const notFound = !parsed.valid || (!editableAuthor && allPosts.length === 0) || parsed.page > totalPages;
if (notFound) Astro.response.status = 404;
const currentPage = notFound ? 1 : parsed.page;
const posts = allPosts.slice((currentPage - 1) * POSTS_PER_PAGE, currentPage * POSTS_PER_PAGE);
const notFoundCategories = notFound ? await listCategories() : [];
const authorObject = allPosts.find((post) => post.author && typeof post.author === 'object')?.author ?? editableAuthor;
const archiveTitle = editableAuthor?.name || labelFromReference(authorObject) || Astro.props.archiveTitle || 'Author';
const authorSeo = (editableAuthor as any)?.seo || (authorObject as any)?.seo || null;
const basePath = '/author/' + parsed.slug;
const seoTitle = authorSeo?.metaTitle || archiveTitle + ' Articles | ' + (config?.seo?.title || 'State News Central');
const description = authorSeo?.metaDescription || editableAuthor?.bio || 'Read the latest articles by ' + archiveTitle + ' from State News Central.';
---

{notFound ? (
	<Base title={`404 | Page Not Found | ${config?.seo?.title || 'State News Central'}`} description="The requested author archive could not be found." noindex={true}>
		<Demo404 posts={allPublishedPosts.slice(0, 3)} categories={notFoundCategories} config={config} />
	</Base>
) : (
	<Base
		title={seoTitle}
		description={description}
		image={authorSeo?.ogImage || editableAuthor?.avatar || undefined}
		ogTitle={authorSeo?.ogTitle || seoTitle}
		ogDescription={authorSeo?.ogDescription || description}
		canonicalUrl={authorSeo?.canonicalUrl || (currentPage > 1 ? `${basePath}/page/${currentPage}/` : basePath + '/')}
		noindex={authorSeo?.noindex || false}
		nofollow={authorSeo?.nofollow || false}
	>
		<TinaIsland name="author" wrapper={islands.author.wrapper} params={{ slug: parsed.slug, page: String(currentPage) }} primary>
			<DemoAuthorArchive archiveTitle={archiveTitle} author={editableAuthor || authorObject} posts={posts} currentPage={currentPage} totalPages={totalPages} basePath={basePath} />
		</TinaIsland>
	</Base>
)}
