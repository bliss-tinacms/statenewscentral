---
export const prerender = false;
const parts = String(Astro.params.slug || '').split('/').filter(Boolean);
const pageIndex = parts.indexOf('page');
const slug = (pageIndex >= 0 ? parts.slice(0, pageIndex) : parts).join('/');
const page = pageIndex >= 0 ? Math.max(1, Number(parts[pageIndex + 1] || '1') || 1) : 1;
if (!slug) return Astro.redirect('/', 301);
const target = page > 1 ? `/author/${slug}/page/${page}/` : `/author/${slug}/`;
return Astro.redirect(target, 301);
---
