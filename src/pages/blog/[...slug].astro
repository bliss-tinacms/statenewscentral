---
import { getBlogPermalink, getBlogRouteSlug } from '../../lib/permalinks';
import { listBlogs } from '../../lib/data';

export const prerender = false;

const routeSlug = (Astro.params.slug ?? '').toString();
const allPosts = await listBlogs();
const matchedPost = allPosts.find((post) => getBlogRouteSlug(post) === routeSlug || post._sys.filename === routeSlug);
if (!matchedPost) return Astro.rewrite('/' + routeSlug + '/');
const target = getBlogPermalink(matchedPost) + '/';
return Astro.redirect(target, 301);
---
