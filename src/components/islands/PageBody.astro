---
import DemoStaticFragment from '../state-news/DemoStaticFragment.astro';
import EditorialPage from '../state-news/EditorialPage.astro';
import SitemapPage from '../state-news/SitemapPage.astro';
import FrontPage from '../../templates/FrontPage.astro';
import { getConfig } from '../../lib/data';
const { data, config = null } = Astro.props;
const currentConfig = config || (await getConfig()).data?.config || null;
const filename = String(data?._sys?.filename || '').toLowerCase();
const permalink = String(data?.permalink || '').replace(/^\/+|\/+$/g,'').toLowerCase();
const key = filename || permalink;
const isHome = key === 'home' || data?.permalink === '/';
let template = 'page';
if (['about','about-us'].includes(key)) template = 'about';
else if (['our-team','team'].includes(key)) template = 'team';
else if (['contact','contact-us'].includes(key)) template = 'contact';
else if (key === 'sitemap') template = 'sitemap';
---
{data && (isHome
  ? <FrontPage data={data} editData={data} config={currentConfig} posts={[]} />
  : template === 'sitemap'
    ? <SitemapPage data={data} />
    : template === 'page' && data?.authoritySections?.length
      ? <EditorialPage data={data} />
      : <DemoStaticFragment template={template} data={data} config={currentConfig} />)}
