---
import sitemapHtml from '../../data/demo-html/sitemap.html?raw';
import { listBlogs, listPages } from '../../lib/data';
import { renderSitemapDemo } from '../../lib/state-news-demo-render';

const providedPages = Astro.props.pages;
const providedPosts = Astro.props.posts;
const pages = Array.isArray(providedPages) ? providedPages : await listPages();
const posts = Array.isArray(providedPosts) ? providedPosts : await listBlogs();
const normalizeHref = (value: any, fallback = '') => {
  const slug = String(value || fallback).replace(/^\/+|\/+$/g, '').replace(/^page\//, '');
  return !slug || slug === 'home' ? '/' : `/${slug}/`;
};
const pageOrder = ['home', 'about', 'our-team', 'contact', 'blog', 'write-for-us', 'editorial-guidelines', 'privacy-policy', 'terms-of-use', 'cookie-policy', 'ai-policy', 'dmca-policy', 'sponsored-content-policy', 'sitemap'];
const pageLabels: Record<string, string> = { home: 'Home', about: 'About Us', 'our-team': 'Our Team', contact: 'Contact Us', blog: 'Blog', 'write-for-us': 'Write for Us', 'editorial-guidelines': 'Editorial Guidelines', 'privacy-policy': 'Privacy Policy', 'terms-of-use': 'Terms of Use', 'cookie-policy': 'Cookie Policy', 'ai-policy': 'AI Policy', 'dmca-policy': 'DMCA Policy', 'sponsored-content-policy': 'Sponsored Content Policy', sitemap: 'Sitemap' };
const publishedPages = pages
  .filter((page: any) => !page?.seo?.noindex)
  .map((page: any) => {
    const href = normalizeHref(page.permalink, page?._sys?.filename);
    const slug = href === '/' ? 'home' : href.replace(/^\/+|\/+$/g, '');
    return { title: pageLabels[slug] || page.title, href, slug };
  })
  .filter((page: any) => page.slug !== 'sitemap');
if (!publishedPages.some((page: any) => page.href === '/blog/')) publishedPages.push({ title: 'Blog', href: '/blog/', slug: 'blog' });
publishedPages.sort((a: any, b: any) => {
  const aIndex = pageOrder.indexOf(a.slug); const bIndex = pageOrder.indexOf(b.slug);
  return (aIndex < 0 ? Number.MAX_SAFE_INTEGER : aIndex) - (bIndex < 0 ? Number.MAX_SAFE_INTEGER : bIndex) || a.title.localeCompare(b.title);
});
const html = renderSitemapDemo(sitemapHtml, { pages: publishedPages, posts });
---
<div class="state-news-authority-fragment" set:html={html} />
