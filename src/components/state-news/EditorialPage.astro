---
import { tinaField } from '@tinacms/astro/tina-field';
const { data } = Astro.props;
const sections = Array.isArray(data?.authoritySections) ? data.authoritySections : [];
const updated = data?.authorityUpdatedDate ? new Date(data.authorityUpdatedDate) : null;
---
<section style="background:#f1f6f2"><div style="max-width:980px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(16px,3vw,32px);text-align:center"><h1 data-tina-field={tinaField(data,'title')} style="font-family:'Young Serif',serif;font-weight:400;font-size:clamp(44px,5.6vw,80px);line-height:1.04;letter-spacing:-.03em;margin:0;color:#17392c">{data?.title}</h1></div></section>
<article style="max-width:820px;margin:0 auto;padding:clamp(52px,7vw,92px) clamp(16px,3vw,32px);color:#2c4238;font-size:18px;line-height:1.8">
  {updated && <p data-tina-field={tinaField(data,'authorityUpdatedDate')} style="margin:0 0 40px;color:#5b6e64;font-size:15px;font-weight:600">Last updated: {updated.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</p>}
  <div data-tina-field={tinaField(data,'authoritySections')}>
    {sections.map((section:any)=><section style="margin-top:42px"><h2 style="font-family:'Young Serif',serif;font-weight:400;font-size:clamp(28px,3vw,40px);line-height:1.15;letter-spacing:-.02em;color:#17392c;margin:0 0 16px">{section.heading}</h2>{String(section.body||'').split(/\n\s*\n/).filter(Boolean).map((paragraph:string)=><p style="margin:0 0 18px">{paragraph}</p>)}</section>)}
  </div>
</article>
