---
import { getBlogPermalink } from '../../lib/permalinks';
import { labelFromReference, getPostCategories } from './DemoHelpers';
const { posts = [], categories = [], config = null } = Astro.props;
const notFound = config?.notFound || {};
const latest = posts.slice(0, 3);
const sections = categories
  .map((category: any) => ({
    label: String(category?.title || category?._sys?.filename || '').trim(),
    slug: String(category?._sys?.filename || '').trim(),
  }))
  .filter((category: { label: string; slug: string }) => category.label && category.slug);
function postUrl(post: any) { const url = getBlogPermalink(post); return url.endsWith('/') ? url : url + '/'; }
function sectionUrl(slug: string) { return '/' + slug.toLowerCase().replace(/[^a-z0-9]+/g, '-') + '/'; }
---

<main class="ffn-demo ffn-demo-404">
  <section class="er"><div class="w"><div class="er-in"><span class="er-num">404</span><div class="er-b"><div class="er-k"><b>Page not found</b></div><h1>{notFound.title || 'This page is not here.'}</h1><p>{notFound.description || 'The link may be broken, or the story may have moved. Nothing was deleted quietly — if a piece was taken down or corrected, we say so on the page.'}</p><div class="er-cta"><a href={notFound.buttonLink || '/'} class="pri">{notFound.buttonText || 'Back to the homepage'} →</a></div></div></div></div></section>
  <section class="sc"><div class="w"><div class="eye"><i></i><span>While you are here</span></div><div class="h2">Latest reporting</div><div class="mo-g">
    {latest.map((post: any) => <a href={postUrl(post)} class="mi">{post.heroImage ? <img class="mi-img" src={post.heroImage} alt="" /> : <div class="mi-img demo-img"></div>}<div class="mi-c"><div class="mi-k">{labelFromReference(getPostCategories(post))}</div><div class="mi-h">{post.title}</div>{post.description && <p class="mi-x">{post.description}</p>}</div></a>)}
  </div></div></section>
  <section class="bd2"><div class="w"><div class="eye"><i></i><span>Or start from a section</span></div><div class="h2">Browse coverage</div><div class="bd2-g">
    {sections.map((section: { label: string; slug: string }, index: number) => <a href={sectionUrl(section.slug)} class="bd2-i"><div class="bd2-n">{String(index + 1).padStart(2, '0')}</div><div class="bd2-t">{section.label}</div></a>)}
  </div></div></section>
</main>
